{
    "dataRoles": [
        {
            "displayName": "X Axis"
            ,"name": "xAxis"
            ,"kind": "Grouping"
        }
        ,{
            "displayName": "Grain"
            ,"name": "grain"
            ,"kind": "Grouping"
        }
        ,{
            "displayName": "Measure Data"
            ,"name": "measure"
            ,"kind": "Measure"
        }
    ]
    ,"objects": {
        "dataPoint": {
            "properties": {
                "defaultColor": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
                ,"showAllDataPoints": {
                    "type": {
                        "bool": true
                    }
                }
                ,"fill": {
                    "type": {
                        "fill": {
                            "solid": {
                                "color": true
                            }
                        }
                    }
                }
                ,"fillRule": {
                    "type": {
                        "fill": {}
                    }
                }
                ,"fontSize": {
                    "type": {
                        "formatting": {
                            "fontSize": true
                        }
                    }
                }
            }
        }
    }
    ,"dataViewMappings": [
        {
            "conditions": [
                {
                    "xAxis": {
                        "min": 1
                    }
                    ,"grain": {
                        "max": 1
                    }
                    ,"measure": {
                        "max": 1
                    }
                }
            ]
            ,"table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "xAxis"
                            }
                        }
                        ,{
                            "for": {
                                "in": "grain"
                            }
                        }
                        ,{
                            "for": {
                                "in": "measure"
                            }
                        }
                    ]
                }
            }
        }
    ]
    ,"privileges": []
}
